# ==============================================================================
# VoiceDesk Environment Configuration
# ==============================================================================

# Project Information
PROJECT_NAME="VoiceDesk — AI-Powered Voice Receptionist"
VERSION="1.0.0"

# Application Security
SECRET_KEY="replace-with-a-secure-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./voicedesk.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://voicedesk:voicedesk_secret_password@localhost:5432/voicedesk"

# PostgreSQL Container Defaults
POSTGRES_USER="voicedesk"
POSTGRES_PASSWORD="voicedesk_secret_password"
POSTGRES_DB="voicedesk"

# Vapi Integration
# Retrieve from https://dashboard.vapi.ai
VAPI_API_KEY="your-vapi-api-key"
VAPI_WEBHOOK_SECRET="your-vapi-webhook-secret"
VAPI_PHONE_NUMBER_ID="your-vapi-phone-number-id"

# OpenAI LLM & Embeddings
OPENAI_API_KEY="your-openai-api-key"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Regional & Business Defaults
DEFAULT_TIMEZONE="Asia/Kolkata"
